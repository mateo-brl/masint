{
  "name": "masint",
  "productName": "MASINT",
  "version": "0.1.0",
  "description": "Application de bureau d'enquête OSINT par graphe : entités, modules d'enrichissement, carte, frise, rapports (Windows, Linux)",
  "keywords": [
    "osint",
    "investigation",
    "enquête",
    "graph",
    "link-analysis",
    "threat-intelligence",
    "electron",
    "desktop"
  ],
  "main": "./out/main/index.js",
  "desktopName": "masint.desktop",
  "author": {
    "name": "Mateo Baril",
    "email": "mateobaril.pro@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/mateo-brl/masint#readme",
  "bugs": {
    "url": "https://github.com/mateo-brl/masint/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mateo-brl/masint.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:core": "node scripts/test-core.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "icons": "node build/scripts/make-icons.mjs",
    "modules:list": "node build/scripts/list-modules.mjs > docs/modules-list.md"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "fetch-socks": "^1.3.3",
    "jszip": "^3.10.2",
    "libphonenumber-geo-carrier": "^2.0.0",
    "libphonenumber-js": "^1.12.31",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "electron": "~44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "html-to-image": "^1.11.13",
    "i18next": "^25.10.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4",
    "simple-icons": "^15.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zustand": "^5.0.15"
  }
}
